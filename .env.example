# ── Supabase ──────────────────────────────────────────────────────────────
# Project Settings → API. The anon (publishable) key is safe for the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Copy this file to ".env" and fill in the real values:
#   cp .env.example .env
#
# No Google client id/secret is needed here — Google OAuth is handled by
# Supabase Auth (configure the Google provider in the Supabase dashboard).

# ── Sync filter (optional) ───────────────────────────────────────────────────
# Only calendar events whose content (title/description/location/attendees)
# contains this text are imported. Leave empty to import all events.
# Defaults to "מלאכי אזערי" when unset.
VITE_REQUIRED_EVENT_TEXT=מלאכי אזערי
